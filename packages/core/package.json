{
  "name": "@bedrock-ui/core",
  "version": "2.5.0",
  "description": "Bedrock UI Core",
  "files": [
    "dist",
    "sass"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && pnpm build:sass",
    "build:sass": "node ./scripts/copy-sass.mjs",
    "build-storybook": "storybook build",
    "dev": "concurrently \"npm run sass:watch\" \"npm run storybook\"",
    "rm:build": "rimraf dist sass",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit",
    "sass:watch": "sass --watch ./src/sass/bedrock-ui.scss css/bedrock-ui.css --style compressed"
  },
  "author": "Matthew Wolfe",
  "license": "MIT",
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-links": "^9.1.10",
    "@storybook/client-api": "^7.6.17",
    "@storybook/react-vite": "^9.1.10",
    "@tabler/icons-react": "^3.35.0",
    "@types/react": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "fs-extra": "^11.3.2",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "sass": "^1.93.2",
    "storybook": "^9.1.10",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  }
}
